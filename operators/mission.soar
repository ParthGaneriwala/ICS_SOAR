echo "\nLoading apply-mission-complete.soar"
sp {apply*apply-mission-complete
    (state <s> ^operator.name apply-mission-complete)
-->
    (<s> ^mission-success <ms> none - success +)
    (write (crlf) |Mission Successful...| )
}


echo "\nLoading apply-mission-not-complete.soar"
sp {apply*apply-mission-not-complete
    (state <s> ^operator.name apply-mission-not-complete)
-->
    (<s> ^mission-success <ms> none - failed +)
    (write (crlf) |Mission Failed...| )
}
