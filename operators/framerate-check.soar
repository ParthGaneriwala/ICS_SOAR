echo "\nLoading framerate-check.soar"

 sp {apply*framerate-check
    (state <s> ^operator.name framerate-check
                ^check framerate <c> 
               ^io.output-link <out>)
    (<out> ^cybersickness-level <cl>)

-->
    (<s> ^check <c> - opticflow-mid +)
    (write (crlf) |Incapacitated...|)
    (<out> ^cybersickness-level <cl> - incapacitated +)
}