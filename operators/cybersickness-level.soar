##!
# @file
#
# @created candice 20250228

echo "\nLoading apply-total-violations-check"
sp {apply*apply-total-violations-check
    (state <s> ^operator.name apply-total-violations-check)
-->
    (<s> ^total-violations <tv> -
         ^total-violations (+ (+ (+ <oc>) <llc>) <luc>) <fc>)
    (write (crlf) |Total Violations: | <tv> )
}

echo "Calculating x2-low"
sp{apply*apply-x2-low
    (state <s> operator.name apply-x2-low)
--> 
    (<s> ^x2 <x2> -
         ^x2 (+ 1 <x2>))
    (write (crlf) |x2 = 1|) 
}

echo "Calculating x2-medium"
sp{apply*apply-x2-medium
    (state <s> operator.name apply-x2-medium)
--> 
    (<s> ^x2 <x2> -
         ^x2 (+ 2 <x2>))
    (write (crlf) |x2 = 2|) 
}

echo "Calculating x2-high"
sp{apply*apply-x2-low
    (state <s> operator.name apply-x2-high)
--> 
    (<s> ^x2 <x2> -
         ^x2 (+ 3 <x2>))
    (write (crlf) |x2 = 3|) 
}