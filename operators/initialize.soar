##!
# @file
#
# @created parth 20250324

echo "\nLoading initialize.soar"
sp {apply*initialize
    (state <s> ^operator.name initialize
               ^io.output-link <out>)
-->
    # -- User state
    (<s> ^name environment-monitor
         ^crowd <c>
         ^start-mission no
         ^action 2                 
         ^time-to-inspect 1
         ^time-to-interact 5
         ^current-time-inspecting 0
         ^current-time-interacting 0
         ^environment none
         ^atrSet no
         ^atrSelected 0
         ^atrRel 0
         ^enviroSet no
         ^confidence 0)
    (<c> ^person <p>)
    (<p> ^id 0
         ^line 0
         ^index 0
         ^x 0.0
         ^y 0.0) 
    (<out> ^action null
           ^current-time-inspecting 0
           ^current-time-interacting 0
           ^attacker-location null)
    (write (crlf) |Agent initialized.|)
}