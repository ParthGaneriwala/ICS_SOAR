##!
# @file
#
# @created parth 20250324

echo "\nLoading initialize.soar"
sp {apply*initialize
    (state <s> ^operator.name initialize
               ^io.output-link <out>)
-->
    # -- User state
    (<s> ^name mission-monitor
         ^start-mission no
         ^action 3                 # Action (0,1,2) -> (Scanning, Deciding, Decided)
         ^sick 0                # Sick (0,1) -> (Not Sick, Sick)
         ^sick_thres 0.5
         ^time-counter 1
         ^total-time 1200
         ^sickness-checked no
         ^sickness-time-interval-set no)
    (<out> ^sick not-sick
           ^event Scan-and-Select
           ^current-time 1
           ^total-time 1200)
    (write (crlf) |Agent initialized.|)
}