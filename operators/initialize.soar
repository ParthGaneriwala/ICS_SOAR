##!
# @file
#
# @created parth 20250324

echo "\nLoading initialize.soar"
sp {apply*initialize
    (state <s> ^operator.name initialize
               ^io.output-link <out>)
-->
    (<s> ^name environment-monitor
         ^crowd <c>
         ^start-mission no
         ^action idle
         ^atr-reviewed no
         ^current-person-id 0
         ^current-person-boxed 0
         ^wall-clock 0
         ^tagged-attacker 0
         ^time-to-inspect 1
         ^current-time-inspecting 0
         ^current-time-interacting 0
         ^environment none
         ^enviroSet no)
    (<c> ^person <p>)
    (<p> ^id 0
         ^line 0
         ^index 0
         ^x 0.0
         ^y 0.0) 
    (<out> ^action null
           ^current-time-inspecting 0
           ^current-time-interacting 0
         ^attacker-location null
         ^current-person-id 0
         ^current-person-boxed 0)
    (write (crlf) |Agent initialized.|)
}