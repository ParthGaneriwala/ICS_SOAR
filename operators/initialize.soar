##!
# @file
#
# @created parth 20250324

echo "\nLoading initialize.soar"
sp {apply*initialize
    (state <s> ^operator.name initialize
               ^io.output-link <out>)
-->
    # -- User state
    (<s> ^name environment-monitor
         ^start-mission no
         ^action 2                 # Action (0,1) -> (Select, Tag)
         ^time-to-inspect 1
         ^time-to-interact 5
         ^current-time-inspecting 0
         ^current-time-interacting 0
         ^environment
         ^crowd 
         ^atr
         ^selected-id 0
         ^reliability 
         ^confidence 0)
    (<out> ^action null
           ^current-time-inspecting 0
           ^current-time-interacting 0
           ^attacker-location null)
    (write (crlf) |Agent initialized.|)
}