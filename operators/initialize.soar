##!
# @file
#
# @created parth 20250324

echo "\nLoading initialize.soar"
sp {apply*initialize
    (state <s> ^operator.name initialize
               ^io.output-link <out>)
-->
    # -- User state
    (<s> ^name environment-monitor
         ^start-mission no
         ^action 3                 # Action (0,1,2) -> (Select, Inspect, Tag)
         ^time-counter 1
         ^total-time 1200)
    (<out> ^event Select
           ^current-time 1
           ^total-time 1200
           ^check-done no)
    (write (crlf) |Agent initialized.|)
}