echo "\nLoading framerate-opticflow-check.soar"

sp {apply*framerate-opticflow-check
    (state <s> ^operator.name framerate-opticflow-check
               ^io.output-link <out>)
    (<out> ^cybersickness-level <cl>)

-->

    (write (crlf) |Incapacitated...|)
    (<out> ^cybersickness-level <cl> -)
    (<out> ^cybersickness-level  (+ <cl> incapacitated))
}
