echo "\nLoading latency-check.soar"

sp {apply*latency-check
    (state <s> ^operator.name latency-check
               ^check latency <c>
               ^io.output-link <out>)
    (<out> ^cybersickness-level <cl>)

-->
    (<s> ^check <c> framerate)
    (write (crlf) |Latency Incapacitated...|<c>)
    (<out> ^cybersickness-level <cl> - incapacitatedd +)
}
