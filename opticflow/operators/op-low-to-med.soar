# === Apply chosen operator ===
sp {apply*op-low-to-med
    (state <s> ^operator.name opticflow-low-to-med)
-->
    (<s> ^opticflow.range medium
         ^last-transition opticflow-low-to-med)
    (write |Transitioned Opticflow from low to medium.| (crlf))
}

