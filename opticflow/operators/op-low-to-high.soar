# === Apply chosen operator ===
sp {apply*op-low-to-high
    (state <s> ^operator.name opticflow-low-to-high)
-->
    (<s> ^opticflow.range high
         ^last-transition opticflow-low-to-high)
    (write |Transitioned Opticflow from low to high.| (crlf))
}

