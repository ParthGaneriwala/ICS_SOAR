echo "\nLoading opticflow-transitions.soar"

#   [] optic_flow=0 -> hs:(optic_flow'=1) + hs:(optic_flow'=2) + no_change:(optic_flow'=0);

sp {propose*opticflow-stay-low
    (state <s> ^name monitor
        ^opticflow.range 0
        ^log-no-change <lognochange>)
-->
    (<s> ^operator <o> + = <lognochange>) # ~ log(0.6)
    (<o> ^name opticflow-stay-low)    
}

sp {propose*opticflow-low-to-med
    (state <s> ^name monitor
        ^opticflow.range 0
        ^log-hs <logopmed>)
-->
    (<s> ^operator <o> + = <logopmed>) # ~ log(0.2)
    (<o> ^name opticflow-low-to-med)    
}

sp {propose*opticflow-low-to-high
    (state <s> ^name monitor
        ^opticflow.range 0
        ^log-hs <logophigh>)
-->
    (<s> ^operator <o> + = <logophigh>) # ~ log(0.2)
    (<o> ^name opticflow-low-to-high)    
}