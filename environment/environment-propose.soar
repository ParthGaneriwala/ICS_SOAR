sp{propose*mental-environment
    (state <s> ^name environment-monitor
               ^io.input-link.environment <env>)
    (<env> ^crowd <crowd>)
    (<crowd> ^person <p>
             ^id <id>
             ^line <line>
             ^index <index>
             ^x <x>
             ^y <y>)
-->
    (<s> ^operator <o> + >,=)
    (<o> ^name apply-mental-environment)
}

sp {propose*atr
    (state <s> ^name environment-monitor
               ^io.input-link.atr <atr>)
    (<atr> ^selected-id <atrSelected>
           ^reliability <atrRel>)
-->
    (<s> ^operator <o> + >,=)
    (<o> ^name apply-atr)
}

# Envrionment -> Mission
sp {propose*transition-mission
    (state <s> ^name environment-monitor)
    (<sd> ^environment no
          ^check-done no)
--> 
    (<s> ^operator <o> + >)
    (<o> ^name switch-monitor)
}