sp {propose*start-mission
    (state <s> ^name environment-monitor
               ^start-mission no
               ^io.input-link.systemdata <sd>)
    (<sd> ^sys-start-mission <sm> > 0)
-->
    (<s> ^operator <o> + >)
    (<o> ^name start-mission ^value <sm>)
}

sp {propose*sync-environment
    (state <s> ^name environment-monitor
               ^enviroSet no
               ^io.input-link.environment.crowd <crowd>)
-->
    (<s> ^operator <o> + =)
    (<o> ^name sync-environment
         ^crowd <crowd>)
}


# Envrionment -> Mission
sp {propose*transition-mission
    (state <s> ^name environment-monitor
               ^start-mission yes
               ^enviroSet yes)
--> 
    (<s> ^operator <o> + >)
    (<o> ^name switch-monitor)
}