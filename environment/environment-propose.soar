##!
# @file
#
# @created candice 20260217

sp {propose*start-mission
    (state <s> ^name environment-monitor
               ^start-mission no
               ^io.input-link.systemdata <sd>)
    (<sd> ^sys-start-mission <sm> > 0)
-->
    (<s> ^operator <o> + >)
    (<o> ^name start-mission ^value <sm>)
}

sp {propose*sync-atr
    (state <s> ^name environment-monitor
               ^atrSet no
               ^io.input-link.atr.selected-id <atrSelected>
               ^io.input-link.atr.reliability <atrRel>
               ^io.input-link.atr.reliability <soarSelected>)
-->
    (<s> ^operator <o> + =)
    (<o> ^name sync-atr
         ^atrSelected <atrSelected>
         ^atrRel <atrRel>
         ^soarSelected <soarSelected>)
}

# Envrionment -> Mission
sp {propose*transition-mission
    (state <s> ^name environment-monitor
               ^start-mission yes
               ^atrSet yes)
--> 
    (<s> ^operator <o> + >)
    (<o> ^name switch-monitor)
}