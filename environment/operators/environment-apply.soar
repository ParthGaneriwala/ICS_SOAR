sp {apply*start-mission
    (state <s> ^operator <o>
               ^start-mission no)
    (<o> ^name start-mission ^value <sm>)
-->
    (<s> ^start-mission no - yes)
    (<s> ^sm <sm>)
}

sp {apply*sync-environment
    (state <s> ^operator <o>
               ^enviroSet no
               ^crowd <oldCrowd>)
    (<o> ^name sync-environment
         ^crowd <crowd>)
-->
    (<s> ^enviroSet no - yes)
    (<s> ^crowd <oldCrowd> - <crowd> +)
}
# Loading transition
sp {apply*transition-mission
    (state <s> ^name environment-monitor
               ^atr-reviewed <atr-reviewed>
               ^current-person-id <cpid>
               ^current-person-boxed <cpboxed>
               ^wall-clock <wall-clock>
               ^tagged-attacker <tagged>
               ^current-time-inspecting <cti>
               ^current-time-interacting <ct>
               ^environment <environment>
               ^io.input-link.scenario.use-box <use-box>
               ^io.output-link <out>
               ^operator.name switch-monitor)
    (<out> ^action <out-a>
           ^current-person-id <out-cpid>
           ^current-person-boxed <out-cpboxed>)
-->
    (write (crlf) |Switched... Environment Monitor to Mission-Monitor|)
    (<s> ^name environment-monitor -)
    (<s> ^name mission-monitor)
    (<s> ^action idle - Waiting +)
    (<s> ^atr-reviewed <atr-reviewed> - no +)
    (<s> ^current-person-id <cpid> - 0 +)
    (<s> ^current-person-boxed <cpboxed> - <use-box> +)
    (<s> ^wall-clock <wall-clock> - 0 +)
    (<s> ^tagged-attacker <tagged> - 0 +)
    (<s> ^current-time-inspecting <cti> - 0 +)
    (<s> ^current-time-interacting <ct> - 0 +)
    (<s> ^environment <environment> - active +)
    (<out> ^action <out-a> - Waiting +
           ^current-person-id <out-cpid> - 0 +
           ^current-person-boxed <out-cpboxed> - <use-box> +)
}