echo "\nLoading latency-check.soar"
sp {apply*apply-latency-violated
    (state <s> ^operator.name apply-latency-violated
                ^latency-counter <lc>
                ^io.output-link <out>)
    (<out> ^cybersickness-level <cl>)
-->
    # (write (crlf) |Latency Incapacitated...|)
    # (<out> ^cybersickness-level <cl> - incapacitated-level-III +)
    (<s> ^latency-counter <lc> -
         ^latency-counter (+ 1 <lc>))
    (write (crlf) |Increment Latency Counter...| <lc>)
}

echo "\nLoading framerate-check.soar"

sp {apply*apply-framerate-check
    (state <s> ^operator.name apply-framerate-violated
                # ^check framerate <c> 
               ^io.output-link <out>)
    (<out> ^cybersickness-level <cl>)

-->
    # (<s> ^check framerate - opticflow-mid +)
    (write (crlf) |Incapacitated...|)
    # (<out> ^cybersickness-check <cc> - framerate +)
    (<out> ^cybersickness-level <cl> - affected-level-II +)

}

sp {apply*apply-opticflow-violated
    (state <s> ^operator.name apply-opticflow-violated
            # ^check opticflow-mid <c>
               ^io.output-link <out>)
    (<out> ^cybersickness-level <cl>)

-->
    # (<s> ^check opticflow - latency +)
    (write (crlf) |Affected...|)
    # (<out> ^cybersickness-check <cc> - opticflow +)
    (<out> ^cybersickness-level <cl> - affected-level-I +)
}

sp {top-state*elaborate*latency-counter-check
    (state <s> ^name hw-cybersickness-monitor
               ^latency-violated <lv> no
               ^io.output-link <out>)
    (<s> ^latency-counter <lc> > 5)
    (<out> ^cybersickness-level <cl>)
-->
    (<s> ^latency-violated <lv> - yes +)
    (<out> ^cybersickness-level <cl> - incapacitated-level-III +)
    (write (crlf) |Latency Incapacitated...|)
    }


