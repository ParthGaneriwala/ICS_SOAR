# @file
#
# @created candice 20240821

echo "\nLoading latency-check-incapacitated.soar"
sp {apply*apply-latency-violated-incapacitated
    (state <s> ^operator.name apply-latency-violated-incapacitated
                ^latency-upper-counter <luc>)
-->
    (<s> ^latency-upper-counter <luc> -
         ^latency-upper-counter (+ 1 <luc>))
    (write (crlf) |Increment Upper Latency Counter...| <luc>)
}

echo "\nLoading latency-check.soar"
sp {apply*apply-latency-violated
    (state <s> ^operator <o>
                ^latency-lower-counter <lc>)
   (<o> ^ name apply-latency-violated
             ^original-latency-lower-counter <lc>)
-->
    (<s> ^latency-lower-counter <lc> -
         ^latency-lower-counter (+ 1 <lc>))
    (write (crlf) |Increment Lower Latency Counter...| <lc>)
}

echo "\nLoading framerate-check.soar"
sp {apply*apply-framerate-check
    (state <s> ^operator.name apply-framerate-violated 
               ^io.output-link <out>)
    (<out> ^cybersickness-level <cl>)

-->
    (write (crlf) |Affected...|)
    (<out> ^cybersickness-level <cl> - affected-level-II +)

}

echo "\nLoading opticflow-check.soar"
sp {apply*apply-opticflow-violated
    (state <s> ^operator.name apply-opticflow-violated
               ^io.output-link <out>)
    (<out> ^cybersickness-level <cl>)

-->
    (write (crlf) |Affected...|)
    (<out> ^cybersickness-level <cl> - affected-level-I +) 
    }

sp {top-state*elaborate*latency-upper-counter-check
    (state <s> ^name hw-cybersickness-monitor
               ^latency-upper-violated no
               ^io.output-link <out>)
    (<s> ^latency-upper-counter <luc> > 20)
    (<out> ^cybersickness-level <cl>)
-->
    (<s> ^latency-upper-violated no - yes +)
    (<out> ^cybersickness-level <cl> - incapacitated-level-III +)
    (write (crlf) |Latency Incapacitated...|)
    }


sp {apply*latency-lower-counter-check
    (state <s> ^name hw-cybersickness-monitor
               ^operator.name apply-latency-lower-counter
               ^io.output-link <out>)
    (<s> ^latency-lower-counter <lc> > 60)
-->
    (<s> ^latency-lower-violated no - yes +)
    (<out> ^cybersickness-level <cl> - affected-level-III +)
    (write (crlf) |Latency Affected...|)
    }
