echo "\nLoading latency-check.soar"
# sp {apply*apply-latency-violated
#     (state <s> ^operator.name apply-latency-violated
#                 ^latency-counter <lc>
#                 ^io.output-link <out>)
#     (<out> ^cybersickness-level <cl>)
# -->
#     (<s> ^latency-counter <lc> -
#          ^latency-counter (+ 1 <lc>))
#     (write (crlf) |Increment Latency Counter...| <lc>)
# }









sp {top-state*elaborate*latency-counter-check
    (state <s> ^name hw-cybersickness-monitor
               ^latency-violated no
               ^io.output-link <out>
               ^latency-counter.current <lcc> >= 20
               ^recovery-counter <rc>)
    (<out> ^cybersickness-level <cl>)
-->
    (<s> ^latency-violated no -)
    (<s> ^latency-violated yes)
    (<s> ^latency-counter.current 20)
    (<s> ^recovery-counter 0
         ^reduce-latency-flag 0)
    (<out> ^cybersickness-level <cl> - affected-III +)
    (write (crlf) |Latency Affected...|)
    }

