# R0: If Sys_latency > latency_upper_threshold then cybersickness_level equal to incapacitated
# latency-check agent
sp {propose*latency-violated-incapacitated
    (state <s> ^name cybersickness-monitor
               ^latency-upper-threshold <lut>
               ^io.input-link.systemdata <sd>)         
    (<sd> ^sys-latency <sl> > <lut>)
-->
    (write (crlf) |Checking for cybersickness for System Latency value: | <sl>)
    (<s> ^operator <o> + >)
    (<o> ^name apply-latency-violated-incapacitated)

    }

# R0: If Sys_latency > latency_problem_threshold then cybersickness_level equal to affected
# latency-check agent
sp {propose*latency-violated
    (state <s> ^name cybersickness-monitor
               ^latency-lower-threshold <lpt>
               ^io.input-link.systemdata <sd>)         
    (<sd> ^sys-latency <sl> > <lpt>)
-->
    (write (crlf) |Checking for cybersickness for System Latency value: | <sl>)
    (<s> ^operator <o> + =)
    (<o> ^name apply-latency-violated)

    }


