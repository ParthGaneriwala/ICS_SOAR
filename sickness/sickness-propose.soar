##!
# @file
#
# @created parth 20250924

echo "\nLoading mission/sickness-propose.soar"

# pdf1 is the measured probability of having reached the operator-selected FMS
# sickness level by the current mission time (cumulative, so non-decreasing).
# <st> is that level's ProbThreshold from the same table -- the half-height of
# its curve, (max + min) / 2 -- so the agent turns sick at the level's median
# onset time. Both arrive on the input-link from the Java side, which re-reads
# them every cycle so that changing the level in the UI re-targets the
# comparison at once.
#
# <st> replaces the old ^sick_thres 0.5 on the state, which asked "are more than
# half of all participants sick by now" -- a population question, not one about
# this agent, and one no FMS level above 4 could ever answer yes to.
#
# The tests are >= and <, so they partition every case. The previous < / > pair
# matched neither rule when pdf1 landed exactly on the threshold, and with
# waitsnc on that stalled the agent instead of impassing. 

echo "\nPropose not sick"
sp {propose*notsick
    (state <s> ^name sickness-monitor
               ^sickness-checked no
               ^io.input-link.systemdata <sd>)
    (<sd> ^sick-thres <st>
          ^pdf1 < <st>)
-->
    (<s> ^operator <o> + >,=)
    (<o> ^name apply-notsick)
}

echo "\nPropose sick"
sp {propose*sick
    (state <s> ^name sickness-monitor
               ^sickness-checked no
               ^io.input-link.systemdata <sd>)
    (<sd> ^sick-thres <st>
          ^pdf1 >= <st>)
-->
    (<s> ^operator <o> + >,=)
    (<o> ^name apply-sick)

}

sp {propose*check*cybersickness
    (state <s> ^name sickness-monitor
               ^sickness-checked yes)
-->
    (<s> ^operator <o> + >)
    (<o> ^name switch-monitor)
    }