# Assigning the users gender

sp {top-state*elaborate*gender-check
    (state <s> ^io.input-link.systemdata.user-gender <ug>)
-->
    (<s> ^gender <ug>)
    (write (crlf) |Assigning the user gender: | <ug>)
    }

sp {top-state*elaborate*set*threshold*male
    (state <s> ^gender Male <g>)
-->
    (<s> ^latency-upper-threshold 50)
    (<s> ^framerate-problem-threshold 50)
    (<s> ^optic-flow-threshold 2)
    (<s> ^scrolling-text-threshold  5)
    (<s> ^threshold-set yes)
    (write (crlf) |Assigning the thresholds for gender: | <g>)
    }

sp {top-state*elaborate*set*threshold*female
    (state <s> ^gender Female <g>)
-->
    (<s> ^latency-upper-threshold 40)
    (<s> ^framerate-problem-threshold 40)
    (<s> ^scrolling-text-threshold  5)
    (<s> ^optic-flow-threshold 1)
    (<s> ^threshold-set yes)
    (write (crlf) |Assigning the thresholds for gender: | <g>)
    }

# sp {top-state*elaborate*check*hw-cybersickness
#     (state <s> ^name demographic-monitor
#                ^gender
#                ^threshold-set yes)
# -->
#     (write (crlf) |Switched...|)
#     (<s> ^name - hw-cybersickness-monitor +)
#     }
sp {propose*check*hw-cybersickness
    (state <s> ^name demographic-monitor
               ^gender
               ^threshold-set yes)
-->
    # (write (crlf) |Switched...|)
    (<s> ^operator <o> + >,=)
    (<o> ^name switch-monitor)
    }