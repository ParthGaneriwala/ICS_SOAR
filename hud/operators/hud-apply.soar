# ---- Idle ----

# Window does not end this tick: stay Idle, +1 tick for 100ms.
sp {hud*apply*idle-idle
    (state <s> ^operator <o>
               ^x-clock <x>)
    (<o> ^name idle-idle)
-->
    (<s> ^x-clock <x> -)
    (<s> ^x-clock (+ <x> 1))
}

# Idle -> Wait: x := 0 (next window).
sp {hud*apply*idle-wait
    (state <s> ^operator <o>
               ^hud-state idle
               ^x-clock <x>)
    (<o> ^name idle-wait)
-->
    (<s> ^hud-state idle -)
    (<s> ^hud-state wait)
    (<s> ^x-clock <x> -)
    (<s> ^x-clock 0)
}

# Idle -> Done (session over).
sp {hud*apply*idle-done
    (state <s> ^operator <o>
               ^hud-state idle)
    (<o> ^name idle-done)
-->
    (<s> ^hud-state idle -)
    (<s> ^hud-state done)
}
