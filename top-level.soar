##!
# @file
#
# @created candice 20240821

echo "\nLoading top-level.soar"

# Initialize agent
sp {propose*initialize
    (state <s> ^superstate nil
               ^io.input-link.systemdata <sd>
               -^name)
 
-->
    (<s> ^operator <o> + >,=)
    (<o> ^name initialize)
    (write (crlf) |Agent initializing...|)

 }

echo "\nLoading task-not-complete"
sp{propose*task-not-complete
  (state <s> )

  (<s> -^io.output-link.cybersickness_level none )
-->
    (write (crlf) |Agent cannot complete task...|)
    (<s> ^operator <o> + = 4.0)
    (<o> ^name apply-task-not-complete)
}

echo "\nLoading task-complete"
sp{propose*task-complete
  (state <s>  ^io.output-link.cybersickness-level)

  (<s> -^io.output-link.cybersickness_level none )
-->
    (write (crlf) |Agent can complete task...|)
    (<s> ^operator <o> + = 3.0)
    (<o> ^name apply-task-complete)
    
}