echo "\nLoading mission/task.soar"

sp {propose*notsick*scan
    (state <s> ^name monitor
               ^action 0
               ^sick 0
               ^time <t>)
 
-->
    (<s> ^operator <o> + >,=)
    (<o> ^name transition)
    (write (crlf) |Agent transitioning...|)

 }
