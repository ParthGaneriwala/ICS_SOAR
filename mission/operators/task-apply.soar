##!
# @file
#
# @created candice 20260217

# Boxed examination succeeds when current person matches attacker.
sp {apply*examine-box-hit
    (state <s> ^name mission-monitor
               ^action <a>
               ^tagged-attacker 0
               ^current-person-id <person-id>
               ^current-person-boxed 1
               ^wall-clock <wall-clock>
               ^current-time-inspecting <cti>
               ^io.input-link.scenario.attacker-id <person-id>
               ^operator.name examine-box
               ^io.output-link <out>)
    (<out> ^action <out-a>
           ^current-time-inspecting <out-cti>
           ^attacker-location <out-al>
           ^current-person-id <out-pid>
           ^current-person-boxed <out-pboxed>)
-->
    (<s> ^tagged-attacker 0 - 1 +)
    (<s> ^action <a> - Tagged +)
    (<s> ^current-person-id <person-id> - (+ <person-id> 1) +)
    (<s> ^current-person-boxed 1 - 0 +)
    (<s> ^current-time-inspecting <cti> - (+ <cti> 1) +)
    (<s> ^wall-clock <wall-clock> - (+ <wall-clock> 1) +)
    (<out> ^action <out-a> - Tagged +
           ^current-time-inspecting <out-cti> - (+ <cti> 1) +
            ^attacker-location <out-al> - <person-id> +
            ^current-person-id <out-pid> - (+ <person-id> 1) +
            ^current-person-boxed <out-pboxed> - 0 +)
    (write (crlf) |Boxed examine matched attacker at person id = | <person-id>)
}

# Boxed examination misses and advances to next (unboxed) person.
sp {apply*examine-box-miss
    (state <s> ^name mission-monitor
               ^action <a>
               ^tagged-attacker 0
               ^current-person-id <person-id>
               ^current-person-boxed 1
               ^wall-clock <wall-clock>
               ^current-time-inspecting <cti>
               ^io.input-link.scenario.attacker-id <attacker-id> <> <person-id>
               ^operator.name examine-box
               ^io.output-link <out>)
    (<out> ^action <out-a>
           ^current-time-inspecting <out-cti>
           ^attacker-location <out-al>
           ^current-person-id <out-pid>
           ^current-person-boxed <out-pboxed>)
-->
    (<s> ^action <a> - Waiting +)
    (<s> ^current-person-id <person-id> - (+ <person-id> 1) +)
    (<s> ^current-person-boxed 1 - 0 +)
    (<s> ^current-time-inspecting <cti> - (+ <cti> 1) +)
    (<s> ^wall-clock <wall-clock> - (+ <wall-clock> 1) +)
    (<out> ^action <out-a> - Waiting +
           ^current-time-inspecting <out-cti> - (+ <cti> 1) +
            ^attacker-location <out-al> - null +
            ^current-person-id <out-pid> - (+ <person-id> 1) +
            ^current-person-boxed <out-pboxed> - 0 +)
    (write (crlf) |Boxed examine miss at person id = | <person-id>)
}

# Unboxed examination succeeds when current person matches attacker.
sp {apply*examine-hit
    (state <s> ^name mission-monitor
               ^action <a>
               ^tagged-attacker 0
               ^current-person-id <person-id>
               ^current-person-boxed 0
               ^wall-clock <wall-clock>
               ^current-time-inspecting <cti>
               ^io.input-link.scenario.attacker-id <person-id>
               ^operator.name examine
               ^io.output-link <out>)
    (<out> ^action <out-a>
           ^current-time-inspecting <out-cti>
           ^attacker-location <out-al>
           ^current-person-id <out-pid>
           ^current-person-boxed <out-pboxed>)
-->
    (<s> ^tagged-attacker 0 - 1 +)
    (<s> ^action <a> - Tagged +)
    (<s> ^current-person-id <person-id> - (+ <person-id> 1) +)
    (<s> ^current-time-inspecting <cti> - (+ <cti> 1) +)
    (<s> ^wall-clock <wall-clock> - (+ <wall-clock> 1) +)
    (<out> ^action <out-a> - Tagged +
           ^current-time-inspecting <out-cti> - (+ <cti> 1) +
            ^attacker-location <out-al> - <person-id> +
            ^current-person-id <out-pid> - (+ <person-id> 1) +
            ^current-person-boxed <out-pboxed> - 0 +)
    (write (crlf) |Examine matched attacker at person id = | <person-id>)
}

# Unboxed examination misses and advances to next person.
sp {apply*examine-miss
    (state <s> ^name mission-monitor
               ^action <a>
               ^tagged-attacker 0
               ^current-person-id <person-id>
               ^current-person-boxed 0
               ^wall-clock <wall-clock>
               ^current-time-inspecting <cti>
               ^io.input-link.scenario.attacker-id <attacker-id> <> <person-id>
               ^operator.name examine
               ^io.output-link <out>)
    (<out> ^action <out-a>
           ^current-time-inspecting <out-cti>
           ^attacker-location <out-al>
           ^current-person-id <out-pid>
           ^current-person-boxed <out-pboxed>)
-->
    (<s> ^action <a> - Waiting +)
    (<s> ^current-person-id <person-id> - (+ <person-id> 1) +)
    (<s> ^current-time-inspecting <cti> - (+ <cti> 1) +)
    (<s> ^wall-clock <wall-clock> - (+ <wall-clock> 1) +)
    (<out> ^action <out-a> - Waiting +
           ^current-time-inspecting <out-cti> - (+ <cti> 1) +
            ^attacker-location <out-al> - null +
            ^current-person-id <out-pid> - (+ <person-id> 1) +
            ^current-person-boxed <out-pboxed> - 0 +)
    (write (crlf) |Examine miss at person id = | <person-id>)
}

sp {apply*deadline-reached
    (state <s> ^name mission-monitor
               ^action <a>
               ^tagged-attacker 0
               ^operator.name deadline-reached
               ^current-person-id <person-id>
               ^current-person-boxed <person-boxed>
               ^io.output-link <out>)
    (<out> ^action <out-a>
           ^attacker-location <out-al>
           ^current-person-id <out-pid>
           ^current-person-boxed <out-pboxed>)
-->
    (<s> ^action <a> - Deadline +)
    (<out> ^action <out-a> - Deadline +
           ^attacker-location <out-al> - null +
           ^current-person-id <out-pid> - <person-id> +
           ^current-person-boxed <out-pboxed> - <person-boxed> +)
    (write (crlf) |Deadline reached before tagging attacker.|)
}

sp {apply*mission-complete-untagged
    (state <s> ^name mission-monitor
               ^action <a>
               ^tagged-attacker 0
               ^current-person-id <person-id>
               ^current-person-boxed <person-boxed>
               ^operator.name mission-complete-untagged
               ^io.output-link <out>)
    (<out> ^action <out-a>
           ^attacker-location <out-al>
           ^current-person-id <out-pid>
           ^current-person-boxed <out-pboxed>)
-->
    (<s> ^action <a> - Not-Tagged +)
    (<out> ^action <out-a> - Not-Tagged +
           ^attacker-location <out-al> - null +
           ^current-person-id <out-pid> - <person-id> +
           ^current-person-boxed <out-pboxed> - <person-boxed> +)
    (write (crlf) |All people examined without tagging attacker.|)
}

sp {apply*mission-complete-tagged
    (state <s> ^name mission-monitor
               ^action <a>
               ^tagged-attacker 1
               ^current-person-id <person-id>
               ^current-person-boxed <person-boxed>
               ^operator.name mission-complete-tagged
               ^io.output-link <out>)
    (<out> ^action <out-a>
           ^current-person-id <out-pid>
           ^current-person-boxed <out-pboxed>)
-->
    (<s> ^action <a> - Complete +)
    (<out> ^action <out-a> - Complete +
           ^current-person-id <out-pid> - <person-id> +
           ^current-person-boxed <out-pboxed> - <person-boxed> +)
    (write (crlf) |Mission complete: attacker tagged.|)
}