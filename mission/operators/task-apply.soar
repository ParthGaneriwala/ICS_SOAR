# Loading apply-SS-transition
sp {apply*apply-SS-transition
    (state <s> ^name mission-monitor
               ^operator <o>
               ^time-counter <tc>
               ^io.output-link <out>)
    (<o>  ^name apply-SS-transition
          ^original-time-counter <tc>)
-->
    (<s> ^time-counter <tc> -
         ^time-counter (+ 1 <tc>))
    (<s> ^action 0)
    (<out> ^event Deciding +)
    (<out> ^current-time (+ 1 <tc>))
    (write (crlf) |State = Deciding | <tc>)
}




# Loading apply-D-transition
sp {apply*apply-D-transition
    (state <s> ^name mission-monitor
               ^operator <o>
               ^time-counter <tc>
               ^io.output-link <out>)
    (<o> ^name apply-D-transition
         ^original-time-counter <tc>)
-->
    (<s> ^time-counter <tc> -
         ^time-counter (+ 1 <tc>))
    (<s> ^action 1)
    (<out> ^event Decided +)
    (<out> ^current-time (+ 1 <tc>))
    (write (crlf) |State = Decided | <tc>)
}

# Loading apply-DD-transition
sp {apply*apply-DD-transition
    (state <s> ^name mission-monitor
               ^operator <o>
               ^time-counter <tc>
               ^io.output-link <out>)
    (<o> ^name apply-DD-transition
         ^original-time-counter <tc>)
-->
    (<s> ^time-counter <tc> -
         ^time-counter (+ 1 <tc>))
    (<s> ^action 2)
    (<out> ^event Scan-and-Select +)
    (<out> ^current-time (+ 1 <tc>))
    (write (crlf) |State = Scan-and-Select | <tc>)
}

# Loading transition
sp {apply*check*transition
    (state <s> ^name mission-monitor
               ^operator.name switch-monitor)
-->
    (write (crlf) |Switched... Mission-Monitor to Task |)
    (<s> ^name mission-monitor -)
    (<s> ^name sickness-monitor)
}