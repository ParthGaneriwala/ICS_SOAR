# Loading apply-S-transition
sp {apply*apply-S-transition
    (state <s> ^name mission-monitor
               ^action <a>
               ^operator <o>
               ^current-time-inspecting <cti>
               ^current-time-interacting <ct>
               ^io.output-link <out>)
    (<out> ^action <out-a>
           ^current-time-inspecting <out-cti>
           ^current-time-interacting <out-ct>)
    (<o>  ^name apply-S-transition)
-->
    (<s> ^action <a> - 0 +)
    (<out> ^action <out-a> - Selecting +
           ^current-time-inspecting <out-cti> - <cti> +
           ^current-time-interacting <out-ct1> - <ct> +)
    (write (crlf) |State = | <out-a>)
}

# Loading apply-T-transition
sp {apply*apply-T-transition
    (state <s> ^name mission-monitor
               ^operator <o>
               ^current-time-inspecting <cti>
               ^current-time-interacting <ct>
               ^io.output-link <out>)
    (<out> ^action <out-a>
           ^attacker-location <al>
           ^current-time-inspecting <out-cti>
           ^current-time-interacting <out-ct>)
    (<o> ^name apply-T-transition)
-->
    (<s> ^action <a> - 1 +)
    (<out> ^action <out-a> - Tagged +
           ^current-time-inspecting <out-cti> - <cti> +
           ^current-time-interacting <out-ct> - <ct> +)
    (write (crlf) |State = | <out-a>)
}