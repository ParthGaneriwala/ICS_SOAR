##!
# @file
#
# @created candice 20250929

sp {top-state*elaborate*startmission
    (state <s> ^io.input-link.systemdata.sys-start-mission <sm>
               ^start-mission no)
-->
    (<s> ^sm <sm>)
    (<s> ^start-mission yes)
    (write (crlf) |Start mission: | <sm>)
}

# Scan and Select -> Deciding
sp {propose*SS-transition
    (state <s> ^name mission-monitor
               ^start-mission yes
               ^time-counter <tc>
               ^total-time <tt>
               ^io.input-link.systemdata <sd>)
    (<s> ^time-counter <tc> < <tt>)
    (<sd> ^pdf2 <p2> )
-->
    (write (crlf) |Transition from Scan and Select to Deciding ...| <p2>)
    (<s> ^operator <o> + = <p2>)
    (<o> ^name apply-SS-transition
         ^original-time-counter <tc>)
}

# Deciding -> Decided
sp {propose*D-transition
    (state <s> ^name mission-monitor
               ^start-mission yes
               ^time-counter <tc>
               ^total-time <tt>
               ^io.input-link.systemdata <sd>)
    (<s> ^time-counter <tc> < <tt>)
    (<sd> ^pdf3 <p3>)
-->
    (write (crlf) |Transition from Deciding to Decided ...| <p3>)
    (<s> ^operator <o> + = <p3>)
    (<o> ^name apply-D-transition
         ^original-time-counter <tc>)
}

# Decided -> Scan and Select
sp {propose*DD-transition
    (state <s> ^name mission-monitor
               ^start-mission yes
               ^time-counter <tc>
               ^total-time <tt>
               ^io.input-link.systemdata <sd>)
    (<s> ^time-counter <tc> < <tt>)
    (<sd> ^pdf4 <p4>)
-->
    (write (crlf) |Transition from Decided to Scan and Select ...| <p4>)
    (<s> ^operator <o> + = <p4>)
    (<o> ^name apply-DD-transition
         ^original-time-counter <tc>)
}

# Some factor of 5 blah blah
sp {propose*check*transition
    (state <s> ^name mission-monitor
               ^start-mission yes
               ^time-counter <tc>)
    (<s> ^time-counter <tc> > 300)
-->
    (write (crlf) |Switched...|)
    (<s> ^operator <o> + >,=)
    (<o> ^name switch-monitor)
}