# @created candice 20250929

sp {top-state*elaborate*startmission
    (state <s> ^io.input-link.systemdata.sys-start-mission <sm>
               ^start-mission no)
-->
    (<s> ^sm <sm>
         ^start-mission yes)
    (write (crlf) |Start mission: | <sm>)
}

# Select -> Inspecting
sp {propose*S-transition
    (state <s> ^name mission-monitor
               ^start-mission yes
               ^io.input-link.systemdata <sd>)
    ()
-->
    (write (crlf) |Transition from Select to Inspecting...|)
    (<s> ^operator <o> + =)
    (<o> ^name apply-S-transition
         ^original-time-counter <tc>)
}

# Inspceting -> Tag
sp {propose*I-transition
    (state <s> ^name mission-monitor
               ^start-mission yes
               ^io.input-link.systemdata <sd>)
    ()
-->
    (write (crlf) |Transition from Inspecting to Tag...| )
    (<s> ^operator <o> + =)
    (<o> ^name apply-I-transition
         ^original-time-counter <tc>)
}

# Tagged
sp {propose*T-transition
    (state <s> ^name mission-monitor
               ^start-mission yes)
-->
    (write (crlf) |Tag Attacker| )
    (<s> ^operator <o> + =)
    (<o> ^name apply-T-transition
         ^original-time-counter <tc>)
}