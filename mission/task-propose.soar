##!
# @file
#
# @created candice 20250929

# PRISM-aligned boxed examination for person 0 when use-box=1.
sp {propose*examine-box
    (state <s> ^name mission-monitor
               ^start-mission yes
               ^action Waiting
               ^tagged-attacker 0
               ^current-person-id <person-id> < 20
               ^current-person-boxed 1
               ^wall-clock <wall-clock> < <deadline>
               ^io.input-link.scenario.deadline <deadline>
               ^io.input-link.timing.step-ready 1)
-->
    (<s> ^operator <o> + >)
    (<o> ^name examine-box
         ^target-id <person-id>)
}

# PRISM-aligned unboxed examination for remaining people.
sp {propose*examine
    (state <s> ^name mission-monitor
               ^start-mission yes
               ^action Waiting
               ^tagged-attacker 0
               ^current-person-id <person-id> < 20
               ^current-person-boxed 0
               ^wall-clock <wall-clock> < <deadline>
               ^io.input-link.scenario.deadline <deadline>
               ^io.input-link.timing.step-ready 1)
-->
    (<s> ^operator <o> + >)
    (<o> ^name examine
         ^target-id <person-id>)
}

# Deadline reached before attacker was tagged.
sp {propose*deadline-reached
    (state <s> ^name mission-monitor
               ^start-mission yes
               ^tagged-attacker 0
               ^wall-clock <wall-clock> >= <deadline>
               ^io.input-link.scenario.deadline <deadline>)
-->
    (<s> ^operator <o> + >)
    (<o> ^name deadline-reached)
}

# All people examined without finding attacker.
sp {propose*mission-complete-untagged
    (state <s> ^name mission-monitor
               ^start-mission yes
               ^action Waiting
               ^tagged-attacker 0
               ^current-person-id <person-id> >= 20)
-->
    (<s> ^operator <o> + >)
    (<o> ^name mission-complete-untagged)
}

# Tagged attacker is a terminal success state in the PRISM-aligned run.
sp {propose*mission-complete-tagged
    (state <s> ^name mission-monitor
               ^start-mission yes
               ^action Tagged
               ^tagged-attacker 1)
-->
    (<s> ^operator <o> + >)
    (<o> ^name mission-complete-tagged)
}