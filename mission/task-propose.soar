##!
# @file
#
# @created candice 20250929

sp {top-state*elaborate*startmission
    (state <s> ^io.input-link.systemdata.sys-start-mission <sm>
               ^start-mission no)
-->
    (<s> ^sm <sm>
         ^start-mission yes)
    (write (crlf) |Start mission: | <sm>)
}

# Selecting an Attacker
sp {propose*S-transition
    (state <s> ^name mission-monitor
               ^start-mission yes
               ^time-to-inspect <tti>
               ^time-to-interact <tt>
               ^current-time-inspecting <cti>
               ^current-time-interacting <ct>
               ^current-time-inspecting <cti> < <tti>
               ^current-time-interacting <ct> < <tt>
               ^action << 0 2 >>
               ^io.input-link.systemdata <sd>)
    ()
-->
    (write (crlf) |Selecting ...|)
    (<s> ^operator <o> + =)
    (<o> ^name apply-S-transition)
}

# Tagged the Attacker
sp {propose*T-transition
    (state <s> ^name mission-monitor
               ^start-mission yes
               ^time-to-inspect <tti>
               ^time-to-interact <tt>
               ^current-time-inspecting <cti>
               ^current-time-interacting <ct>
               ^current-time-inspecting <cti> < <tti>
               ^current-time-interacting <ct> < <tt>
               ^action 0
               ^io.input-link.systemdata <sd>)
    ()
-->
    (write (crlf) |Tag Attacker| )
    (<s> ^operator <o> + =)
    (<o> ^name apply-T-transition)
}