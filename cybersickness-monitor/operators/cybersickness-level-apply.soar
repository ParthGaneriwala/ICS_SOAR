echo "\nLoading apply-x1"
sp {apply*apply-x1
    (state <s> ^operator.name apply-x1
             ^latency-lower-counter <llc>
             ^latency-upper-counter <luc>
             ^opticflow-counter <oc>
             ^framerate-counter <fc>
             ^x1 <x1>
             ^x1-set <x1-set>)
-->
    (<s> ^x1 <x1> -
         ^x1 (+ (+ (+ (+ <oc>) <llc>) <luc>) <fc>))
    (<s> ^x1-set <x1-set> - yes +)
    (write (crlf) |x1: | <x1> )
}

echo "Calculating x2-low"
sp {apply*apply-x2-low
    (state <s> ^operator.name apply-x2-low
               ^x2 <x2>
               ^x2-set <x2-set>)
--> 
    (<s> ^x2 <x2> -
         ^x2 (+ 1 <x2>))
    (<s> ^x2-set <x2-set> - yes +)
    (write (crlf) |x2 = 1|) 
}

echo "Calculating x2-medium"
sp {apply*apply-x2-medium
    (state <s> ^operator.name apply-x2-medium
               ^x2 <x2>
               ^x2-set <x2-set>)
--> 
    (<s> ^x2 <x2> -
         ^x2 (+ 2 <x2>))
    (<s> ^x2-set <x2-set> - yes +)
    (write (crlf) |x2 = 2|) 
}

echo "Calculating x2-high"
sp {apply*apply-x2-high
    (state <s> ^operator.name apply-x2-high
               ^x2 <x2>
               ^x2-set <x2-set>)
--> 
    (<s> ^x2 <x2> -
         ^x2 (+ 3 <x2>))
    (<s> ^x2-set <x2-set> - yes +)
    (write (crlf) |x2 = 3|) 
}

